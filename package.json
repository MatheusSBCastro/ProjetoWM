{
  "name": "gym-moviment",
  "version": "1.0.0",
  "private": true,
  "description": "Gestão de alunos, professores e consultoria Gym Moviment",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:browser": "playwright test --headed --project=chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:visual": "node scripts/playwright-visual-audit.js",
    "test:motion": "node scripts/playwright-motion-preview.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0"
  }
}
